<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SDM Pi Market - Buy with Pi</title>
<script src="https://sdk.minepi.com/pi-sdk.js"></script>
<style>
body{font-family:Arial;background:#f5f5f5;margin:0;padding:10px}
.header{background:#6a1b9a;color:white;padding:20px;text-align:center;border-radius:10px}
.header h1{margin:0}
.badge{background:#4caf50;color:white;padding:8px;border-radius:5px;margin-top:10px;display:inline-block}
.product{background:white;padding:15px;margin:10px 0;border-radius:10px;box-shadow:0 2px 5px #ddd}
.product h3{margin:0}
button{background:#6a1b9a;color:white;border:none;padding:10px 15px;border-radius:5px;font-size:16px;cursor:pointer}
.cart{background:white;padding:15px;border-radius:10px;position:sticky;top:0}
.checkout{background:#ff9800;width:100%;padding:15px;font-size:18px}
</style>
</head>
<body>
<div class="header">
<h1>🛒 SDM Pi Market</h1>
<p>Buy with Pi - Maiduguri, Borno State</p>
<p>By Umar Bukar Saduma</p>
<div class="badge" id="piStatus">Checking Pi Browser...</div>
</div>

<div class="cart">
<h3>🛒 Cart: <span id="cartTotal">0</span> Pi</h3>
<p id="cartItems">No items yet</p>
<button class="checkout" onclick="checkout()">Checkout - Pay with Pi</button>
</div>

<div class="product"><h3>🌴 Palm Oil - 5 Litres</h3><p>Fresh from Maiduguri</p><p><b>2 Pi</b></p><button onclick="addToCart('Palm Oil',2)">+ Add</button></div>
<div class="product"><h3>🍲 Maggi Cubes - Pack</h3><p>Original Maggi</p><p><b>1 Pi</b></p><button onclick="addToCart('Maggi',1)">+ Add</button></div>
<div class="product"><h3>🧂 Salt - 1kg</h3><p>Fine Salt</p><p><b>0.5 Pi</b></p><button onclick="addToCart('Salt',0.5)">+ Add</button></div>
<div class="product"><h3>🍚 Rice - 5kg</h3><p>Local Rice</p><p><b>5 Pi</b></p><button onclick="addToCart('Rice',5)">+ Add</button></div>
<div class="product"><h3>🍬 Sugar - 1kg</h3><p>White Sugar</p><p><b>1.5 Pi</b></p><button onclick="addToCart('Sugar',1.5)">+ Add</button></div>

<p style="text-align:center">Delivery in Maiduguri - Call: Umar Bukar Saduma<br>SDM Pi Market © 2026</p>

<script>
let cart=[]; let total=0;
function addToCart(name,price){cart.push(name); total+=price; document.getElementById('cartTotal').innerText=total; document.getElementById('cartItems').innerText=cart.join(', '); alert(name+' added!');}
function checkout(){
  if(total==0){alert('Add product first!'); return;}
  alert('Pay '+total+' Pi - Pi Payment will open in Pi Browser');
  if(window.Pi){ Pi.createPayment({amount:total, memo:'SDM Pi Market Order', metadata:{order:cart.join(',')}}, {onReadyForServerApproval:function(id){alert('Payment ID: '+id)}, onReadyForServerCompletion:function(id,tx){alert('Payment Done!')}, onCancel:function(){alert('Cancelled')}, onError:function(e){alert('Error '+e)}}); }
}
window.onload=function(){
  if(window.Pi){ Pi.init({version:"2.0", sandbox:true}); document.getElementById('piStatus').innerText='✅ Pi Browser Detected - Ready to Pay'; }
  else{ document.getElementById('piStatus').innerText='⚠️ Open in Pi Browser to Pay'; document.getElementById('piStatus').style.background='#ff9800'; }
}
</script>
</body>
</html>
